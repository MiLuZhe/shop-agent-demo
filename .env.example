POSTGRES_DB=shop_agent_demo
POSTGRES_USER=shop_agent
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://shop_agent:replace_with_a_local_password@127.0.0.1:5433/shop_agent_demo?schema=public

# Browser origins allowed for mutation requests. Match your local frontend URL.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:3000,http://localhost:3000
# Local demo defaults. Applied only when the seeded account has no password yet.
DEMO_BUYER_PASSWORD=BuyerDemo123!
DEMO_SELLER_PASSWORD=SellerDemo123!
DEMO_MANAGER_PASSWORD=ManagerDemo123!
DEMO_STAFF_PASSWORD=StaffDemo123!
# disabled: human only; mock: offline preview; deepseek: verified live Responses guide.
# deepseek requires DEEPSEEK_API_KEY and consumes model tokens; restart API after changes.
AGENT_MODE=mock

# Key may be inherited from your shell. Never commit a real key.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Keep existing exclusions when customizing; both forms serve different clients.
NO_PROXY=localhost,127.0.0.1,::1,api.deepseek.com
no_proxy=localhost,127.0.0.1,::1,api.deepseek.com

# Backend-only image storage: local (default) or tos (private bucket, HTTPS and signed reads).
SHOP_IMAGE_STORAGE=local
# Credentials must remain empty in this example. Never use VITE_* names for secrets.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# Optional when the AK/SK comes from STS temporary credentials.
TOS_SESSION_TOKEN=
TOS_REGION=cn-shanghai
# The Node.js TOS SDK accepts a hostname here; enable HTTPS in the client options.
TOS_ENDPOINT=tos-cn-shanghai.volces.com
TOS_BUCKET=agent-shop-demo

# Optional production limits; local defaults stay unchanged when omitted.
# API_HOST=127.0.0.1
# API_PORT=3000
# DATABASE_POOL_MAX=5
# AGENT_CONCURRENCY=1
# COPILOT_CONCURRENCY=1
# AGENT_QUEUE_LIMIT=4
